{
    "name": "understudy-family-docs",
    "private": true,
    "type": "module",
    "scripts": {
        "docs:api": "node scripts/generate-api.mjs",
        "docs:check": "node scripts/check-integrity.mjs",
        "docs:check:anchors": "node scripts/check-anchors.mjs",
        "docs:check:cookbook": "node scripts/check-cookbook.mjs",
        "docs:check:links": "node scripts/check-links.mjs",
        "docs:dev": "vitepress dev src",
        "docs:build": "npm run docs:check:drafts && vitepress build src",
        "docs:preview": "vitepress preview src",
        "docs:check:drafts": "node scripts/check-drafts.mjs"
    },
    "devDependencies": {
        "markdown-link-check": "^3.15.0",
        "vitepress": "^1.6.4"
    }
}
