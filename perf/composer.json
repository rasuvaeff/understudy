{
    "name": "rasuvaeff/understudy-perf",
    "description": "Comparative benchmark harness: understudy against the established PHP test-double libraries",
    "license": "BSD-3-Clause",
    "type": "project",
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "require": {
        "php": "8.3 - 8.5",
        "mockery/mockery": "^1.6",
        "phpspec/prophecy": "^1.19",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rasuvaeff/understudy": "@dev",
        "testo/testo": "^0.10.25"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Understudy\\Perf\\": "benchmarks/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "bench": "testo --suite=Benchmarks -vv"
    }
}
